# ─────────────────────────────────────────────────────────────
# 로컬 개발용 비밀값 템플릿
#
# 사용법:
#   1. 이 파일을 **프로젝트 루트**(이 파일과 같은 위치)에 application-secret.yml 로 복사
#      cp application-secret.yml.example application-secret.yml
#   2. 값을 본인 로컬 환경에 맞게 채운다
#   3. application-secret.yml 은 .gitignore 처리돼 있다 — 절대 커밋하지 않는다
#
# ⚠️ src/main/resources 에 두지 말 것.
#    거기에 두면 .gitignore 와 무관하게 processResources 가 jar 에 담고,
#    Dockerfile 의 COPY src 로 이미지에도 포함된다(비밀값 유출).
#
# application.yaml 이 optional:file:./application-secret.yml 로 불러오며,
# 아래 키들이 ${DB_URL} 등 플레이스홀더로 치환된다.
# (file: 경로는 실행 작업 디렉터리 기준 = 프로젝트 루트)
#
# 운영/스테이징에는 이 파일을 두지 않는다.
# SSM Parameter Store(/itta/spring/, SecureString)가 환경변수로 주입하며,
# 환경변수가 이 파일보다 우선순위가 높다. (infra/deploy.sh 참고)
# ─────────────────────────────────────────────────────────────

DB_URL: jdbc:mysql://localhost:3306/module06
DB_USERNAME: module06
DB_PASSWORD: 여기에_본인_비밀번호

# 엔티티와 마이그레이션 불일치를 부팅 시점에 잡는다. 기본값 validate.
JPA_DDL_AUTO: validate
