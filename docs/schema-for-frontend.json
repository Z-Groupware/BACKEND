        { "name": "team_id",       "type": "BIGINT",       "nullable": true,  "note": "부서. 온보딩 전 오너는 NULL" },
        { "name": "role_id",       "type": "BIGINT",       "nullable": false, "default": 2, "note": "역할. 2 = 없음. NULL 을 쓰지 않는다" },
        { "name": "position_id",   "type": "BIGINT",       "nullable": true,  "note": "직급. 온보딩 전 오너는 NULL" },
