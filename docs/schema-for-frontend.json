{
  "$comment": "module06 identity 스키마 — 프론트 공유용. 2026-08-06 네이밍 통일(V2.3.x) 반영본. Flyway 마이그레이션 기준이며 JPA 엔티티와 일치한다.",
  "generatedAt": "2026-08-06",
  "migrationLevel": "V2.3.11",

  "namingRule": {
    "$comment": "화면 라벨과 DB 이름을 1:1로 맞췄다. 이 세 줄만 외우면 된다.",
    "화면 '역할'": {
      "table": "role",
      "memberColumn": "role_id",
      "apiKey": "roleName / roleId",
      "예시": "프론트엔드, 백엔드, 인사, 리더, 없음",
      "인가에 쓰나": false
    },
    "화면 '직급'": {
      "table": "position",
      "memberColumn": "position_id",
      "apiKey": "positionName / positionId",
      "예시": "팀장, 과장, 대리, 사원",
      "인가에 쓰나": false
    },
    "화면 '권한'": {
      "table": null,
      "memberColumn": "authority",
      "apiKey": "authority",
      "예시": "OWNER, LEADER, MEMBER",
      "인가에 쓰나": true
    }
  },

  "breakingChanges": {
    "$comment": "프론트가 지금 쓰고 있다면 반드시 고쳐야 하는 것들. 기존 access token은 만료 전까지 구 role 클레임을 그대로 들고 있다 — refresh token은 그대로 살아 있어 재로그인 없이 재발급 시점에 새 authority 클레임으로 자동 교체된다.",
    "jwtClaim": { "before": "role", "after": "authority" },
    "responseKeys": [
      { "before": "role", "after": "authority", "where": "GET /api/auth/me" },
      { "before": "roleLabel", "after": "roleName", "where": "GET /api/auth/me" },
      { "before": "jobPositionId", "after": "positionId", "where": "GET /api/auth/me" }
    ],
    "renamedColumns": [
      { "table": "company", "before": "business_number", "after": "registration_no" }
    ],
    "removed": [
      { "field": "annual_leave_granted", "reason": "연차 이번 범위 아님" },
      { "field": "mustChangePassword", "reason": "비밀번호 변경 기능 없음" }
    ]
  },

  "tables": {
