        { "name": "privacy_agreed_at",   "type": "DATETIME",     "nullable": true,  "note": "개인정보 동의 시각 (필수 동의)" },
        { "name": "marketing_agreed_at", "type": "DATETIME",     "nullable": true,  "note": "마케팅 동의 시각 (선택). NULL 이면 미동의" },
