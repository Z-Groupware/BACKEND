# 이 파일을 application-secret.yaml 로 복사해서 값을 채운다(복사본은 .gitignore로 커밋되지 않는다).
#
#   cp application-secret.yaml.example application-secret.yaml
#
# 키 이름은 application.yaml이 참조하는 것과 같아야 한다. 운영은 SSM Parameter Store가
# 같은 이름의 환경변수로 주입한다(infra/deploy.sh) → 로컬은 이 파일이 그 자리를 채운다.
#
# DB_URL 같은 키는 아무도 읽지 않는다. application.yaml이 url을 직접 조립하기 때문:
#   jdbc:mysql://${DB_HOST}:3306/${DB_NAME}?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# 포트·타임존·인코딩은 application.yaml이 갖고 있으므로 host와 name만 준다.

DB_HOST: localhost
DB_NAME: module06
DB_USERNAME: <로컬 DB 계정>
DB_PASSWORD: <로컬 DB 비밀번호>

# 엔티티와 마이그레이션 불일치를 부팅 시점에 잡는다. 로컬 권장값 validate.
# (application.yaml 기본값은 none — 스키마를 건드리지 않는다)
JPA_DDL_AUTO: validate
